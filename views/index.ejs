<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oasis Social</title>
    <link href="/img/logo.png" rel="icon" type="image/png">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</head>

<div class="background-animation"></div>
<nav class="navbar navbar-expand-lg navbar-oasis">
    <div class="container">
        <a class="navbar-brand" href="/">Oasis Social</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/about">Sobre</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="btn btn-primary ms-2 text-white px-4" href="/register">Começar</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="display-4 fw-bold mb-3">Bem-vindo ao Oasis Social</h1>
            <p class="lead mb-4">Um lugar simples para compartilhar coisas boas.</p>

            <div class="d-flex justify-content-center gap-3 mb-5">
                <a href="/register" class="btn btn-primary btn-lg">Criar Conta</a>
                <a href="/about" class="btn btn-outline-secondary btn-lg">Sobre Nós</a>
            </div>

            <img src="/img/logo.png" alt="Oasis Social" class="img-fluid rounded shadow-sm" style="max-height: 300px;">
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card-oasis h-100 p-4">
                <h3>Amigos</h3>
                <p>Encontre seus amigos.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-oasis h-100 p-4">
                <h3>Posts</h3>
                <p>Veja mensagens legais.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-oasis h-100 p-4">
                <h3>Segurança</h3>
                <p>Tudo seguro por aqui.</p>
            </div>
        </div>
    </div>
</div>

<footer>
    <p>Feito por Foyth. &copy; 2026</p>
</footer>

