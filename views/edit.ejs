<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Post - Oasis Social</title>
    <link rel="stylesheet" href="/public/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-oasis">
        <div class="container">
            <a class="navbar-brand" href="/feed">Oasis Social</a>
        </div>
    </nav>
    <div class="container mt-5">
        <div class="card-oasis">
            <h4>Editar Post</h4>
            <form action="/post/update/<%= post.id %>" method="post">
                <div class="mb-3">
                    <label for="content" class="form-label">Conteúdo</label>
                    <textarea class="form-control" id="content" name="content" rows="4"
                        required><%= post.content %></textarea>
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Categoria</label>
                    <input type="text" class="form-control" id="category" name="category" value="<%= post.category %>"
                        required>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="/feed" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</body>

</html>