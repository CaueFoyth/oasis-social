<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed</title>
    <link rel="stylesheet" href="/public/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-oasis">
        <div class="container">
            <a class="navbar-brand" href="#">Oasis Social</a>
            <div class="d-flex align-items-center">
                <span class="me-3">Olá, <strong>
                        <%= user.name %>!
                    </strong></span>
                <a href="/login" class="btn btn-outline-danger btn-sm"
                    onclick="document.cookie = 'session_id=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card-oasis mb-5">
                    <h4 class="mb-3">Compartilhe algo bom!</h4>
                    <form action="/post" method="post">
                        <div class="mb-3">
                            <label for="content" class="form-label visually-hidden">Conteúdo</label>
                            <textarea class="form-control" id="content" name="content" rows="3"
                                placeholder="Escreva algo positivo..." required><%= content || '' %></textarea>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">
                                <label for="category" class="form-label visually-hidden">Categoria</label>
                                <input type="text" class="form-control" id="category" name="category"
                                    placeholder="Categoria (ex: Gratidão)" value="<%= category || '' %>" required>
                            </div>
                            <div class="col-md-6 text-end">
                                <button type="submit" class="btn btn-primary px-4">Publicar</button>
                            </div>
                        </div>
                    </form>
                </div>

                <h3 class="mb-4">Últimas vibrações</h3>

                <% if (error) { %>
                    <div class="alert alert-warning mb-4 shadow-sm border-0" role="alert">
                        <%= error %>
                    </div>
                    <% } %>

                        <div class="list-group gap-3">
                            <% if (locals.posts && posts.length> 0) { %>
                                <% posts.forEach(post=> { %>
                                    <div class="card-oasis p-4 mb-3">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">
                                                        <%= post.author %>
                                                    </h6>
                                                    <small class="text-muted" style="font-size: 0.8rem;">
                                                        <%= post.created_at ? new
                                                            Date(post.created_at).toLocaleDateString('pt-BR') : 'Hoje'
                                                            %>
                                                    </small>
                                                </div>
                                            </div>
                                            <span class="post-category badge rounded-pill bg-light text-dark border">
                                                <%= post.category %>
                                            </span>
                                        </div>
                                        <p class="card-text fs-5 mb-3">
                                            <%= post.content %>
                                        </p>
                                        <div class="border-top pt-3 d-flex gap-3">
                                            <button
                                                class="btn btn-sm text-secondary p-0 d-flex align-items-center gap-1"
                                                style="background: none; border: none;">
                                                <i class="far fa-heart"></i> Curtir
                                            </button>
                                            <button
                                                class="btn btn-sm text-secondary p-0 d-flex align-items-center gap-1"
                                                style="background: none; border: none;">
                                                <i class="far fa-comment"></i> Comentar
                                            </button>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="text-center p-5 text-muted">
                                                <p class="mb-0">Ainda não há posts. Seja o primeiro a espalhar
                                                    positividade!</p>
                                            </div>
                                            <% } %>
                        </div>
            </div>
        </div>
    </div>
</body>

<footer>
    <p>Feito por Foyth. &copy; 2026</p>
</footer>

</html>